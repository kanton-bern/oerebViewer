{
  "name": "oereb-viewer",
  "version": "3.0.0",
  "description": "Source code to setup a viewer for the Cadastre of Public-law Restrictions on landownership (DE: \u00d6REB-Kataster) displaying the JSON-Extract of the PLR-cadastre.",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "predev": "node scripts/copy-theme-fonts.js",
    "start": "npx serve dist",
    "generate": "nuxi generate",
    "pregenerate": "node scripts/copy-theme-fonts.js",
    "lint:js": "eslint",
    "lint": "npm run lint:js",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "json2ts": "json2ts -i 'schemas/**/*.json' -o types/",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "postinstall": "nuxi prepare"
  },
  "author": "kanton-bern",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kanton-bern/oerebViewer/issues"
  },
  "homepage": "https://github.com/kanton-bern/oerebViewer",
  "dependencies": {
    "nuxt": "^4.5.2",
    "ol": "^10.2.0",
    "proj4": "^2.8.0",
    "vue-multiselect": "^3.1.0",
    "vue3-toastify": "^0.2.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.0",
    "@nuxt/eslint": "^1.16.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.1",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "happy-dom": "^20.11.1",
    "json-schema-to-typescript": "^15.0.2",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.8",
    "vue-router": "^5.2.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "overrides": {
    "@intlify/vue-i18n-extensions": "^9.0.0"
  }
}
